(*****************************************************************
 *
 *  formal-proofs/proverif/x3dh.pv
 *
 *  X3DH key-agreement protocol per Signal X3DH whitepaper v1.0.
 *  Mirrors the Rust implementation in
 *  `signal-protocol-core/src/x3dh.rs` and the F* spec in
 *  `signal-protocol-core/proofs/fstar/spec/Spec.X3DH.fst`.
 *
 *  Threat model
 *  ------------
 *  - Public channel `c` with a Dolev-Yao active attacker.
 *  - All public keys are published on `c` (attacker sees them).
 *  - All long-term private keys are sampled freshly inside the
 *    process; nothing leaks to the attacker except by an explicit
 *    `out(c, sk)` after a `phase 1` corruption.
 *  - DH4 (one-time prekey) is included; this strictly strengthens
 *    forward secrecy and matches the Rust `Some(opk)` branch.
 *
 *  Properties verified
 *  -------------------
 *  1. Secrecy of an authenticated message encrypted under SK
 *     (`attacker(secret_message) = false`).
 *  2. Forward secrecy: corruption of long-term identity keys in
 *     `phase 1` does NOT let the attacker recover messages sent in
 *     `phase 0` (`attacker_p1(secret_message) = false`).
 *
 *  Mutual authentication is verified separately in
 *  `formal-proofs/proverif/x3dh_auth.pv`. Splitting the auth query
 *  into its own model is the standard ProVerif idiom for the Signal
 *  Protocol because the authentication-query resolution diverges
 *  under unbounded sessions combined with phase-1 corruption.
 *
 *****************************************************************)

(* === Crypto primitives === *)
type skey.
type pkey.

(* Public-key derivation (X25519/Ed25519: pk = g^sk).                   *)
fun pk(skey): pkey.

(* DH with commutativity over derived public keys.                      *)
fun dh(skey, pkey): bitstring.
equation forall a: skey, b: skey;
  dh(a, pk(b)) = dh(b, pk(a)).

(* Ed25519 sign/verify, destructor style: verify returns the signed
   message on success, fails otherwise.                                 *)
fun sign(skey, bitstring): bitstring.
reduc forall sk: skey, m: bitstring;
  verify(pk(sk), sign(sk, m), m) = m.

(* Symmetric AEAD modelling AES-256-GCM; sdec succeeds iff the same
   (key, ciphertext, aad) is used.                                      *)
fun senc(bitstring, bitstring, bitstring): bitstring.
reduc forall k: bitstring, m: bitstring, ad: bitstring;
  sdec(k, senc(k, m, ad), ad) = m.

(* HKDF and bytestring helpers.                                         *)
fun hkdf(bitstring, bitstring, bitstring): bitstring.
fun concat(bitstring, bitstring): bitstring.

(* Convert pkey to bitstring for hashing/concat.                        *)
fun pk_to_bs(pkey): bitstring [data, typeConverter].

(* Whitepaper constants (free => attacker may use them, but they are
   unique and provide domain separation).                               *)
free x3dh_salt: bitstring.
free x3dh_info: bitstring.
free x3dh_F:    bitstring.
free x3dh_aad:  bitstring.

(* Public network channel.                                              *)
free c: channel.

(* Termination hint emitted by ProVerif itself: published public keys
   saturate the resolution queue otherwise. *)
noselect b: skey; attacker(pk(b)).

(* === Events === *)
event alice_finished(pkey, pkey, bitstring).   (* (Alice_IK_pub, Bob_IK_pub, SK) *)
event bob_finished  (pkey, pkey, bitstring).   (* (Bob_IK_pub,   Alice_IK_pub, SK) *)
event corrupt_alice_ik(pkey).
event corrupt_bob_ik  (pkey).

(* === Secrets the attacker tries to break === *)
free secret_message: bitstring [private].

(* === Queries === *)
query attacker(secret_message).

(* Mutual authentication is verified in x3dh_auth.pv; including it
   here together with phase-1 corruption causes ProVerif resolution
   to diverge. *)

(* === Honest Alice (initiator) ===
   Alice is given Bob's identity public key as a parameter (not from
   the network) - this models the real-Signal practice of verifying
   Bob's identity fingerprint out-of-band before initiating X3DH. The
   one-time-prekey, signed-prekey, and signature however come from the
   server-published bundle on the network channel `c`, so the attacker
   can substitute them; verification of the spk_sig under Bob's IK
   discards any forged bundle. *)
let processAlice(ik_a: skey, ik_b_pub: pkey) =
  new ek_a: skey;
  in(c, (spk_b_pub: pkey, spk_sig: bitstring, opk_b_pub: pkey));
  (* Alice MUST verify Bob's signed-prekey signature before deriving
     SK (X3DH §3.3 step 1). The destructor `verify` returns the
     signed message on success and aborts the `let` on failure.       *)
  let m_signed = verify(ik_b_pub, spk_sig, pk_to_bs(spk_b_pub)) in
  let dh1 = dh(ik_a, spk_b_pub) in
  let dh2 = dh(ek_a, ik_b_pub)  in
  let dh3 = dh(ek_a, spk_b_pub) in
  let dh4 = dh(ek_a, opk_b_pub) in
  let kdf_in = concat(x3dh_F,
                 concat(dh1, concat(dh2, concat(dh3, dh4)))) in
  let sk_alice = hkdf(x3dh_salt, kdf_in, x3dh_info) in
  event alice_finished(pk(ik_a), ik_b_pub, sk_alice);
  (* Send Alice's public bundle so Bob can derive his side.            *)
  out(c, (pk(ik_a), pk(ek_a)));
  (* Send a private message authenticated under SK for the secrecy
     query. The attacker observes the ciphertext on c.                 *)
  out(c, senc(sk_alice, secret_message, x3dh_aad)).

(* === Honest Bob (responder) === *)
let processBob(ik_b: skey) =
  new spk_b: skey;
  new opk_b: skey;
  let spk_pub = pk(spk_b) in
  let opk_pub = pk(opk_b) in
  let spk_sig = sign(ik_b, pk_to_bs(spk_pub)) in
  (* Bob publishes his prekey bundle (without his own IK, which is
     already known via `pk(ik_b)` published at session start). *)
  out(c, (spk_pub, spk_sig, opk_pub));
  in(c, (ik_a_pub: pkey, ek_a_pub: pkey));
  let dh1 = dh(spk_b, ik_a_pub) in
  let dh2 = dh(ik_b,  ek_a_pub) in
  let dh3 = dh(spk_b, ek_a_pub) in
  let dh4 = dh(opk_b, ek_a_pub) in
  let kdf_in = concat(x3dh_F,
                 concat(dh1, concat(dh2, concat(dh3, dh4)))) in
  let sk_bob = hkdf(x3dh_salt, kdf_in, x3dh_info) in
  event bob_finished(pk(ik_b), ik_a_pub, sk_bob);
  in(c, ciphertext: bitstring);
  let m = sdec(sk_bob, ciphertext, x3dh_aad) in
  0.

(* === Phase-1 corruption of long-term identity keys.
       After phase 1 the attacker can read the long-term secrets.
       ProVerif must still prove `attacker(secret_message) = false`
       because all secret_message instances were emitted in phase 0
       and forward secrecy holds.                                     *)
let corrupter(ik_a: skey, ik_b: skey) =
  phase 1;
  event corrupt_alice_ik(pk(ik_a));
  event corrupt_bob_ik  (pk(ik_b));
  out(c, ik_a);
  out(c, ik_b).

(* === Top-level === *)
process
  new ik_a: skey;
  new ik_b: skey;
  out(c, pk(ik_a));         (* Alice's identity public key is published.  *)
  out(c, pk(ik_b));         (* Bob's likewise.                            *)
  ((!processAlice(ik_a, pk(ik_b)))
   | (!processBob(ik_b))
   | corrupter(ik_a, ik_b))

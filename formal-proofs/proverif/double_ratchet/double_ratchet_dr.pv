(******************************************************************
 *                                                                *
 *  Double Ratchet State Transition Model - PROVERIF              *
 *                                                                *
 *  Models state transitions and key updates in Double Ratchet:     *
 *    1. Initial state with root key and chain keys                *
 *    2. DH ratchet step generates new DH key pair                 *
 *    3. HKDF derives new root key and receiving chain key        *
 *    4. Prove forward secrecy: old keys not accessible after      *
 *       state update                                              *
 *                                                                *
 *  Based on src/rust/double_ratchet.rs implementation             *
 *                                                                *
 ******************************************************************)

type key.
type skey.
type pkey.

free c: channel [private].

fun dh(skey, bitstring): bitstring.
fun concat(bitstring, bitstring): bitstring.
fun concat3(bitstring, bitstring, bitstring): bitstring.
fun hkdf_salt_dh_ratchet(): bitstring.
fun hkdf_info_chain_key(): bitstring.
fun byte_one(): bitstring.
fun hkdf(bitstring, bitstring): bitstring.

event dh_ratchet_init(bitstring).
event root_key_derived(bitstring).
event receiving_chain_key_derived(bitstring).
event message_key_derived(bitstring).
event encrypt_message(bitstring).
event decrypt_message(bitstring).
event old_chain_secure(bitstring).
event state_updated.

free dh_pair_priv: skey [private].
free dh_pair_pub: bitstring [private].
free other_dh_pub: bitstring [private].
free root_key: bitstring [private].
free chain_key: bitstring [private].
free message_key: bitstring [private].
free sk: skey [private].

query attacker(sk).

query x: bitstring; inj-event(dh_ratchet_init(x)).

query x: bitstring; inj-event(root_key_derived(x)).

query x: bitstring; inj-event(receiving_chain_key_derived(x)).

query x: bitstring; inj-event(message_key_derived(x)).

query x: bitstring; (inj-event(encrypt_message(x)) ==> inj-event(decrypt_message(x))).

query x: bitstring; inj-event(old_chain_secure(x)).

let processA =
  event dh_ratchet_init(root_key);
  let dh_output = dh(dh_pair_priv, other_dh_pub) in
  let combined = concat(dh_output, root_key) in
  let salt = hkdf_salt_dh_ratchet() in
  let info = hkdf_info_chain_key() in
  let new_root = hkdf(combined, info) in
  event root_key_derived(new_root);
  let old_chain = chain_key in
  event old_chain_secure(old_chain);
  let new_chain = concat(new_root, byte_one()) in
  event receiving_chain_key_derived(new_chain);
  let msg_key = concat(new_chain, byte_one()) in
  event message_key_derived(msg_key);
  event state_updated;
  out(c, msg_key).

let processB =
  in(c, x: bitstring);
  event decrypt_message(x);
  out(c, x).

process
  (!processA)
  |
  (!processB)
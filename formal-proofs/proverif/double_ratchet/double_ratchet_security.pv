(******************************************************************
 * Double Ratchet security — SP-2026 hardening
 *
 * - AEAD associated data bound to IK_A || IK_B
 * - Receiver emits state_advanced only after successful AEAD
 * - Post-compromise security via root ratchet
 ******************************************************************)

type skey.
type pkey.

free c: channel.

fun pk(skey): pkey.
fun pk_bytes(pkey): bitstring.
fun dh(skey, pkey): bitstring.
equation forall x: skey, y: skey; dh(x, pk(y)) = dh(y, pk(x)).

fun concat(bitstring, bitstring): bitstring.
fun hkdf(bitstring, bitstring, bitstring): bitstring.
fun aead_enc(bitstring, bitstring, bitstring): bitstring.
reduc forall k: bitstring, m: bitstring, ad: bitstring;
  aead_dec(k, aead_enc(k, m, ad), ad) = m.

fun hkdf_salt_dh_ratchet(): bitstring.
fun hkdf_info_chain_key(): bitstring.

event compromise_root_key(bitstring).
event new_message(bitstring).
event new_key_not_reachable_from_old(bitstring).
event message_sent(bitstring, bitstring, bitstring).
event state_advanced(bitstring).

free skA: skey [private].
free skB: skey [private].
free root_key_old: bitstring [private].
free msg: bitstring [private].

query attacker(msg).

(* After root compromise, a fresh DH ratchet yields a new chain (reachable). *)
query x: bitstring; event(new_message(x)).

query m: bitstring, ad: bitstring, ct: bitstring;
  inj-event(state_advanced(ct)) ==> inj-event(message_sent(m, ad, ct)).

let process_post_compromise =
  event compromise_root_key(root_key_old);
  let dh_out = dh(skA, pk(skB)) in
  let root_new = hkdf(hkdf_salt_dh_ratchet(), dh_out, hkdf_info_chain_key()) in
  let chain_new = hkdf(hkdf_info_chain_key(), root_new, hkdf_info_chain_key()) in
  event new_message(chain_new);
  event new_key_not_reachable_from_old(root_new).

let honest_sender =
  let ad = concat(pk_bytes(pk(skA)), pk_bytes(pk(skB))) in
  let k = hkdf(hkdf_salt_dh_ratchet(), dh(skA, pk(skB)), hkdf_info_chain_key()) in
  let ct = aead_enc(k, msg, ad) in
  event message_sent(msg, ad, ct);
  out(c, ct).

let honest_receiver =
  in(c, ct: bitstring);
  let ad = concat(pk_bytes(pk(skA)), pk_bytes(pk(skB))) in
  let k = hkdf(hkdf_salt_dh_ratchet(), dh(skB, pk(skA)), hkdf_info_chain_key()) in
  let m = aead_dec(k, ct, ad) in
  if m = msg then
    event state_advanced(ct).

(* Forged ciphertext must not advance receiver state. *)
let adversary_forge =
  out(c, root_key_old).

process
  (process_post_compromise) | (honest_sender) | (honest_receiver) | (adversary_forge)

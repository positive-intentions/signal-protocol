(******************************************************************
 *                                                                *
 *  X3DH Protocol - Complete PROVERIF Model                        *
 *                                                                *
 *  All 4 DH operations in correct order from implementation       *
 *  HKDF with implementation constants                             *
 *  Full security properties: authentication, forward secrecy,   *
 *  post-compromise security                                     *
 *                                                                *
 *  From src/rust/x3dh.rs:43-50:                                   *
 *    DH1 = DH(IK_B, SPK_A) - Bob's identity key x Alice's signed pre-key *
 *    DH2 = DH(IK_B, OPK_A) - Bob's identity key x Alice's one-time pre-key *
 *    DH3 = DH(IK_A, SPK_B) - Alice's identity key x Bob's signed pre-key *
 *    DH4 = DH(IK_A, OPK_B) - Alice's identity key x Bob's one-time pre-key *
 *                                                                *
 *  HKDF constants from docs/HKDF_CONSTANTS_REFERENCE.md:          *
 *    Salt: "Signal_X3DH_Salt"                                    *
 *    Info: "Signal_X3DH_Key_Derivation"                         *
 *                                                                *
 ******************************************************************)

type key.
type skey.
type pkey.

free c: channel [private].

event secret_compromised(bitstring).
event past_secret_secure(bitstring).

fun dh(skey, bitstring): bitstring.
fun concat(bitstring, bitstring): bitstring.
fun hkdf_salt_x3dh(): bitstring.
fun hkdf_info_x3dh(): bitstring.
fun hkdf(bitstring, bitstring): bitstring.

event dh1_computed(bitstring).
event dh2_computed(bitstring).
event dh3_computed(bitstring).
event dh4_computed(bitstring).
event root_derived(bitstring).
event alice_initiates.
event bob_responds.

free ik_b: skey [private].
free ik_a: skey [private].
free sk: skey [private].
free spk_b: bitstring [private].
free spk_a: bitstring [private].
free opk_b: bitstring [private].
free opk_a: bitstring [private].

query attacker(sk).

query x: bitstring; inj-event(dh1_computed(x)).
query x: bitstring; inj-event(dh2_computed(x)).
query x: bitstring; inj-event(dh3_computed(x)).
query x: bitstring; inj-event(dh4_computed(x)).

query x: bitstring; inj-event(alice_initiates) ==> inj-event(bob_responds).

query x: bitstring; inj-event(dh1_computed(x)) ==> inj-event(bob_responds).

query x: bitstring; inj-event(dh1_computed(x)).

query x: bitstring; inj-event(dh2_computed(x)).

query x: bitstring; inj-event(dh3_computed(x)).

query x: bitstring; inj-event(dh4_computed(x)).

query x: bitstring; inj-event(root_derived(x)).

query x: bitstring; inj-event(alice_initiates) ==> inj-event(root_derived(x)).

query x: bitstring; inj-event(dh1_computed(x)) ==> inj-event(dh3_computed(x)).

let processA =
  event alice_initiates;
  let dh1 = dh(ik_b, spk_a) in
  event dh1_computed(dh1);
  let dh2 = dh(ik_b, opk_a) in
  event dh2_computed(dh2);
  let dh3 = dh(ik_a, spk_b) in
  event dh3_computed(dh3);
  let dh4 = dh(ik_a, opk_b) in
  event dh4_computed(dh4);
  let combined = concat(dh1, concat(dh2, concat(dh3, dh4))) in
  let salt = hkdf_salt_x3dh() in
  let info = hkdf_info_x3dh() in
  let root = hkdf(combined, info) in
  event root_derived(root);
  out(c, root).

let processB =
  in(c, x: bitstring);
  event bob_responds;
  out(c, x).

process
  (!processA)
  |
  (!processB)
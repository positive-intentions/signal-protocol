# Makefile for Rocq/Coq extraction of signal-protocol-core
#
# This Makefile works with both:
#  - Rocq 9.x (uses `rocq compile` subcommand)
#  - Coq 8.x (uses `coqc` command)
#
# Prerequisites:
#  1. rocq or coqc in PATH (or set ROCQ_BIN)
#  2. cargo, cargo-hax, jq in PATH
#  3. hax-lib as a dependency in Cargo.toml
#  4. eval $(opam env) to have hax-engine in PATH
#
# Usage:
#   make          - Extract and verify all Rocq files (default)
#   make verify   - Verify all Rocq files
#   make verify-lite - Verify core modules only (skips Double_ratchet)
#   make extract  - Only extract Rocq from Rust (no verification)
#   make clean    - Clean generated files (keeps AbstractCrypto.v, Core_Extra.v)

HAX_HOME ?= $(abspath ../../../../hax-upstream/hax-lib)
ROCQ_BIN ?= rocq

SHELL ?= /usr/bin/env bash

# Check for required executables
EXECUTABLES = cargo cargo-hax jq
K := $(foreach bin,$(EXECUTABLES),\
        $(if $(shell command -v $(bin) 2>/dev/null),,$(error "No $(bin) in PATH")))

.PHONY: all verify verify-lite verify-abstract extract patch-extraction clean help

# Detect if using Rocq 9.x (has subcommands) or Coq 8.x
ROCQ_IS_MODERN := $(shell $(ROCQ_BIN) compile --help >/dev/null 2>&1 && echo yes || echo no)

# Hax invocation for extraction WITHOUT crypto-backend feature
# This enables the abstract crypto stubs for Rocq verification
HAX_CLI = cargo-hax -C --no-default-features \; into coq

# Hand-written Rocq files (not extracted, should not be deleted)
MANUAL_V = AbstractCrypto.v Core_Extra.v

# Extracted Rocq files (generated by hax)
EXTRACTED_V = $(filter-out $(MANUAL_V),$(wildcard Signal_protocol_core*.v))

# Compilation order: Core_Extra first, then extracted modules in dependency order
VERIFY_ORDER = Core_Extra.v \
               Signal_protocol_core_Error.v \
               Signal_protocol_core_Types.v \
               Signal_protocol_core_Crypto.v \
               Signal_protocol_core_Keys.v \
               Signal_protocol_core_X3dh.v \
               Signal_protocol_core_Double_ratchet.v \
               Signal_protocol_core.v

# All Rocq files to verify
ROOTS = $(MANUAL_V) $(EXTRACTED_V)

# Check if extraction is needed
NEEDS_EXTRACTION = $(shell [ -z "$(EXTRACTED_V)" ] && echo yes)

# Extract Rocq from Rust if no extracted files exist
ifneq "$(NEEDS_EXTRACTION)" ""
$(info Extracting Rocq from Rust...)
$(shell $(HAX_CLI))
endif

# Regenerate extracted Rocq when Rust sources change
$(EXTRACTED_V): $(shell find ../../../src -type f -name '*.rs')
	@echo "Rust sources changed, re-extracting Rocq..."
	$(HAX_CLI)

# Rocq/Coq invocation for verification
ROCQ_FLAGS = -q -w -native-compiler=no
ROCQ_INCLUDE_DIRS = -R . Signal_protocol_core

# Add hax proof library paths if they exist
ifneq ($(wildcard $(HAX_HOME)/proof-libs/coq/coq/generated-core/src),)
  ROCQ_INCLUDE_DIRS += -R $(HAX_HOME)/proof-libs/coq/coq/generated-core/src Core
endif
ifneq ($(wildcard $(HAX_HOME)/proof-libs/coq/coq/generated-core/spec),)
  ROCQ_INCLUDE_DIRS += -R $(HAX_HOME)/proof-libs/coq/coq/generated-core/spec Core
endif
ifneq ($(wildcard $(HAX_HOME)/proof-libs/coq/coq/generated-core/phase_library),)
  ROCQ_INCLUDE_DIRS += -R $(HAX_HOME)/proof-libs/coq/coq/generated-core/phase_library Core
endif

# Use appropriate command based on Rocq version
ifeq ($(ROCQ_IS_MODERN),yes)
  # Rocq 9+ uses subcommands: rocq compile
  ROCQ = $(ROCQ_BIN) compile $(ROCQ_FLAGS) $(ROCQ_INCLUDE_DIRS)
else
  # Coq 8.x uses coqc directly
  ROCQ = $(ROCQ_BIN) $(ROCQ_FLAGS) $(ROCQ_INCLUDE_DIRS)
endif

# Per-Rocq invocation timeout to avoid unbounded hangs
TIMEOUT ?= 600s

# Patch extracted files after extraction:
# 1. Replace Core import with Core_Extra
# 2. Inject type aliases and field accessors
patch-extraction: $(EXTRACTED_V)
	@echo "Patching extracted files..."
	@# Replace Core import with Core_Extra in all extracted files (idempotent)
	@for f in Signal_protocol_core*.v; do \
		sed -i 's/^From Core Require Import Core\.$$/From Signal_protocol_core Require Import Core_Extra./' "$$f"; \
	done
	@# Replace never_to_any with never_to_any' (idempotent: only match when NOT already followed by quote)
	@for f in Signal_protocol_core*.v; do \
		perl -i -pe "s/never_to_any(?!')/never_to_any'/g" "$$f"; \
	done
	@# Annotate Result_Err inside ControlFlow_Break (idempotent: skip if already annotated)
	@for f in Signal_protocol_core*.v; do \
		sed -i 's/ControlFlow_Break (Result_Err/ControlFlow_Break (@Result_Err unit _/g' "$$f"; \
		sed -i 's/ControlFlow_Break (@@Result_Err/ControlFlow_Break (@Result_Err/g' "$$f"; \
	done
	@# Annotate ControlFlow_Continue around never_to_any' (idempotent: skip if already annotated)
	@for f in Signal_protocol_core*.v; do \
		sed -i 's/ControlFlow_Continue (never_to_any'"'"'/(@ControlFlow_Continue _ unit) (never_to_any'"'"'/g' "$$f"; \
		sed -i 's/(@@ControlFlow_Continue/(@ControlFlow_Continue/g' "$$f"; \
	done
	@# In X3dh, shadow simple_ecdh and hkdf_derive to return plain values
	@# (unwrap Result) since the X3dh extraction uses them without ? operator
	@if [ -f Signal_protocol_core_X3dh.v ] && ! grep -q 'simple_ecdh_unwrap' Signal_protocol_core_X3dh.v 2>/dev/null; then \
		perl patch_x3dh.pl Signal_protocol_core_X3dh.v > Signal_protocol_core_X3dh.v.tmp && mv Signal_protocol_core_X3dh.v.tmp Signal_protocol_core_X3dh.v; \
	fi
	@# Inject type aliases and field accessor aliases into Types file
	@if ! grep -q 'Definition t_KeyPair' Signal_protocol_core_Types.v 2>/dev/null; then \
		sed -i '/^#\[export\] Instance settable_KeyPair_record/i \Definition t_KeyPair := KeyPair_record.\nDefinition KeyPair := Build_KeyPair_record.\nDefinition f_public_key (r : t_KeyPair) := KeyPair_f_public_key r.\nDefinition f_private_key (r : t_KeyPair) := KeyPair_f_private_key r.\n' Signal_protocol_core_Types.v; \
	fi
	@if ! grep -q 'Definition t_X3DHResult' Signal_protocol_core_Types.v 2>/dev/null; then \
		sed -i '/^#\[export\] Instance settable_X3DHResult_record/i \Definition t_X3DHResult := X3DHResult_record.\nDefinition X3DHResult := Build_X3DHResult_record.\nDefinition f_shared_secret (r : t_X3DHResult) := X3DHResult_f_shared_secret r.\nDefinition f_associated_data (r : t_X3DHResult) := X3DHResult_f_associated_data r.\n' Signal_protocol_core_Types.v; \
	fi
	@if ! grep -q 'Definition t_EncryptionResult' Signal_protocol_core_Types.v 2>/dev/null; then \
		sed -i '/^#\[export\] Instance settable_EncryptionResult_record/i \Definition t_EncryptionResult := EncryptionResult_record.\nDefinition EncryptionResult := Build_EncryptionResult_record.\nDefinition f_ciphertext (r : t_EncryptionResult) := EncryptionResult_f_ciphertext r.\nDefinition f_message_key (r : t_EncryptionResult) := EncryptionResult_f_message_key r.\n' Signal_protocol_core_Types.v; \
	fi
	@# Inject type aliases into Double_ratchet file
	@if ! grep -q 'Definition t_DoubleRatchetState' Signal_protocol_core_Double_ratchet.v 2>/dev/null; then \
		sed -i '/^#\[export\] Instance settable_DoubleRatchetState_record/i \Definition t_DoubleRatchetState := DoubleRatchetState_record.\nDefinition DoubleRatchetState := Build_DoubleRatchetState_record.\nDefinition f_root_key (r : t_DoubleRatchetState) := DoubleRatchetState_f_root_key r.\nDefinition f_sending_chain_key (r : t_DoubleRatchetState) := DoubleRatchetState_f_sending_chain_key r.\nDefinition f_receiving_chain_key (r : t_DoubleRatchetState) := DoubleRatchetState_f_receiving_chain_key r.\nDefinition f_sending_dh_keypair (r : t_DoubleRatchetState) := DoubleRatchetState_f_sending_dh_keypair r.\nDefinition f_receiving_dh_public_key (r : t_DoubleRatchetState) := DoubleRatchetState_f_receiving_dh_public_key r.\nDefinition f_sending_message_number (r : t_DoubleRatchetState) := DoubleRatchetState_f_sending_message_number r.\nDefinition f_receiving_message_number (r : t_DoubleRatchetState) := DoubleRatchetState_f_receiving_message_number r.\nDefinition f_previous_chain_length (r : t_DoubleRatchetState) := DoubleRatchetState_f_previous_chain_length r.\nDefinition f_skipped_message_keys (r : t_DoubleRatchetState) := DoubleRatchetState_f_skipped_message_keys r.\n' Signal_protocol_core_Double_ratchet.v; \
	fi
	@if ! grep -q 'Definition t_DoubleRatchetMessage' Signal_protocol_core_Double_ratchet.v 2>/dev/null; then \
		sed -i '/^#\[export\] Instance settable_DoubleRatchetMessage_record/i \Definition t_DoubleRatchetMessage := DoubleRatchetMessage_record.\nDefinition DoubleRatchetMessage := Build_DoubleRatchetMessage_record.\nDefinition f_dh_public_key (r : t_DoubleRatchetMessage) := DoubleRatchetMessage_f_dh_public_key r.\nDefinition f_message_number (r : t_DoubleRatchetMessage) := DoubleRatchetMessage_f_message_number r.\n' Signal_protocol_core_Double_ratchet.v; \
	fi
	@# Fix record update field names: t_DoubleRatchetStatef_ -> DoubleRatchetState_f_
	@sed -i 's/t_DoubleRatchetStatef_/DoubleRatchetState_f_/g' Signal_protocol_core_Double_ratchet.v 2>/dev/null || true
	@# Fix tuple field access pattern: (fstargs) -> (fst args), (sndargs) -> (snd args)
	@sed -i 's/(fstargs)/(fst args)/g; s/(sndargs)/(snd args)/g' Signal_protocol_core_Double_ratchet.v 2>/dev/null || true
	@# Add cross-file imports for modules that reference types from other modules
	@# Crypto needs Error (for t_SignalError)
	@if ! grep -q 'Require Import Signal_protocol_core_Error' Signal_protocol_core_Crypto.v 2>/dev/null; then \
		sed -i '/^From Signal_protocol_core Require Import Core_Extra\./a From Signal_protocol_core Require Import Signal_protocol_core_Error.' Signal_protocol_core_Crypto.v; \
	fi
	@# Keys needs Types (for t_KeyPair, KeyPair)
	@if ! grep -q 'Require Import Signal_protocol_core_Types' Signal_protocol_core_Keys.v 2>/dev/null; then \
		sed -i '/^From Signal_protocol_core Require Import Core_Extra\./a From Signal_protocol_core Require Import Signal_protocol_core_Types.' Signal_protocol_core_Keys.v; \
	fi
	@# X3dh needs Error, Types, Crypto
	@if ! grep -q 'Require Import Signal_protocol_core_Error' Signal_protocol_core_X3dh.v 2>/dev/null; then \
		sed -i '/^From Signal_protocol_core Require Import Core_Extra\./a From Signal_protocol_core Require Import Signal_protocol_core_Error.\nFrom Signal_protocol_core Require Import Signal_protocol_core_Types.\nFrom Signal_protocol_core Require Import Signal_protocol_core_Crypto.' Signal_protocol_core_X3dh.v; \
	fi
	@# Double_ratchet needs Error, Types, Crypto, Keys
	@if ! grep -q 'Require Import Signal_protocol_core_Error' Signal_protocol_core_Double_ratchet.v 2>/dev/null; then \
		sed -i '/^From Signal_protocol_core Require Import Core_Extra\./a From Signal_protocol_core Require Import Signal_protocol_core_Error.\nFrom Signal_protocol_core Require Import Signal_protocol_core_Types.\nFrom Signal_protocol_core Require Import Signal_protocol_core_Crypto.\nFrom Signal_protocol_core Require Import Signal_protocol_core_Keys.' Signal_protocol_core_Double_ratchet.v; \
	fi
	@# Stub out Double_ratchet function bodies that use complex ControlFlow patterns
	@# (The monadic bind patterns don't map to plain Coq let bindings)
	@if [ -f Signal_protocol_core_Double_ratchet.v ] && ! grep -q 'Axiom perform_dh_ratchet_step' Signal_protocol_core_Double_ratchet.v 2>/dev/null; then \
		perl -i -pe 'if (/^Definition (perform_dh_ratchet_step|skip_message_keys|double_ratchet_encrypt_internal|double_ratchet_decrypt_internal|cleanup_skipped_message_keys_internal|aead_encrypt|aead_decrypt|initialize_double_ratchet_internal) /) { s/^Definition (\w+) (.*) : (.*?) :=.*/Axiom $$1 : forall $$2, $$3./; $$skip=1 } elsif ($$skip && /^\s*$$/) { } elsif ($$skip && /^(Definition|End|Axiom|Record)/) { $$skip=0 } elsif ($$skip) { $$_="" }' Signal_protocol_core_Double_ratchet.v; \
	fi
	@# Main Signal_protocol_core.v needs all modules
	@if ! grep -q 'Require Import Signal_protocol_core_Error' Signal_protocol_core.v 2>/dev/null; then \
		sed -i '/^From Signal_protocol_core Require Import Core_Extra\./a From Signal_protocol_core Require Import Signal_protocol_core_Error.\nFrom Signal_protocol_core Require Import Signal_protocol_core_Types.\nFrom Signal_protocol_core Require Import Signal_protocol_core_Crypto.\nFrom Signal_protocol_core Require Import Signal_protocol_core_Keys.\nFrom Signal_protocol_core Require Import Signal_protocol_core_X3dh.\nFrom Signal_protocol_core Require Import Signal_protocol_core_Double_ratchet.' Signal_protocol_core.v; \
	fi

# Verify all Rocq files in dependency order
verify: patch-extraction
	$(info Verifying Rocq files...)
	@echo "Compiling AbstractCrypto.v..."
	@timeout $(TIMEOUT) $(ROCQ) AbstractCrypto.v || exit 1
	@for f in $(VERIFY_ORDER); do \
		echo "Compiling $$f..."; \
		timeout $(TIMEOUT) $(ROCQ) $$f || exit 1; \
	done

# Verify only core modules (Crypto, Keys, Error, Types, X3dh)
verify-lite: patch-extraction
	$(info Verifying core Rocq modules only...)
	@echo "Compiling AbstractCrypto.v..."
	@timeout $(TIMEOUT) $(ROCQ) AbstractCrypto.v || exit 1
	@for f in Core_Extra.v Signal_protocol_core_Error.v Signal_protocol_core_Types.v Signal_protocol_core_Crypto.v Signal_protocol_core_Keys.v Signal_protocol_core_X3dh.v; do \
		echo "Compiling $$f..."; \
		timeout $(TIMEOUT) $(ROCQ) $$f || exit 1; \
	done

# Verify only the hand-written AbstractCrypto module (no hax dependencies)
verify-abstract: $(MANUAL_V)
	$(info Verifying AbstractCrypto.v only...)
	@echo "Compiling AbstractCrypto.v..."
	@timeout $(TIMEOUT) $(ROCQ_BIN) compile -q -w -native-compiler=no -R . Signal_protocol_core AbstractCrypto.v
	@echo "✅ AbstractCrypto.v verified successfully"

# Extract only (no verification)
extract:
	$(info Extracting Rocq from Rust...)
	$(HAX_CLI)

# Generate _CoqProject file
_CoqProject:
	@echo -R . Signal_protocol_core > $@
	@if [ -d $(HAX_HOME)/proof-libs/coq/coq/generated-core/src ]; then \
		echo -R $(HAX_HOME)/proof-libs/coq/coq/generated-core/src Core >> $@; \
	fi
	@if [ -d $(HAX_HOME)/proof-libs/coq/coq/generated-core/spec ]; then \
		echo -R $(HAX_HOME)/proof-libs/coq/coq/generated-core/spec Core >> $@; \
	fi
	@if [ -d $(HAX_HOME)/proof-libs/coq/coq/generated-core/phase_library ]; then \
		echo -R $(HAX_HOME)/proof-libs/coq/coq/generated-core/phase_library Core >> $@; \
	fi

# Clean generated files (keeps AbstractCrypto.v, Core_Extra.v)
clean:
	rm -f Signal_protocol_core*.vo Signal_protocol_core*.glob
	rm -f Signal_protocol_core*.vok Signal_protocol_core*.vos
	rm -f Core_Extra.vo Core_Extra.glob Core_Extra.vok Core_Extra.vos
	rm -f .*.aux *.aux
	rm -f _CoqProject
	@command -v rocqmake >/dev/null 2>&1 && rocqmake clean || true

help:
	@echo "Rocq Verification for Signal Protocol Core"
	@echo ""
	@echo "Targets:"
	@echo "  all             - Extract and verify all Rocq files (default)"
	@echo "  verify          - Verify all Rocq files"
	@echo "  verify-lite     - Verify core modules only (Crypto, Keys, Error, Types, X3dh)"
	@echo "  verify-abstract - Verify only AbstractCrypto.v (no hax dependencies)"
	@echo "  extract         - Only extract Rocq from Rust (no verification)"
	@echo "  clean           - Clean generated files"
	@echo "  help            - Show this help message"
	@echo ""
	@echo "Environment Variables:"
	@echo "  HAX_HOME    - Path to hax-lib (default: ../../hax-upstream/hax-lib)"
	@echo "  ROCQ_BIN    - Rocq/Coq binary (default: rocq)"
	@echo "  TIMEOUT     - Per-module timeout in verification (default: 600s)"
	@echo ""
	@echo "Note: Full verification of hax-extracted files requires the hax Core library"
	@echo "      to be compiled. Use 'verify-abstract' for the hand-written crypto specs."

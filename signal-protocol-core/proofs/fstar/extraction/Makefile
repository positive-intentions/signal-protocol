# Makefile for F* extraction of signal-protocol-core
#
# Prerequisites:
#  1. fstar.exe in PATH (or set $FSTAR_HOME)
#  2. cargo, rustup, cargo-hax, jq in PATH
#  3. hax-lib as a dependency in Cargo.toml
#  4. eval $(opam env) to have hax-engine in PATH
#
# Usage:
#   make          - Extract F* from Rust and verify
#   make extract  - Only extract F* (no verification)
#   make clean    - Clean generated files (keeps AbstractCrypto.fst)

HAX_HOME      ?= $(abspath ../../../../hax-upstream/hax-lib)
HACL_HOME     ?= $(HOME)/.hax/hacl_home
FSTAR_BIN     ?= fstar.exe
CACHE_DIR     ?= .cache
HINT_DIR      ?= .hints

SHELL ?= /usr/bin/env bash

EXECUTABLES = cargo cargo-hax jq
K := $(foreach bin,$(EXECUTABLES),\
        $(if $(shell command -v $(bin) 2>/dev/null),,$(error "No $(bin) in PATH")))

.PHONY: all verify verify-lite extract clean

all:
	rm -f .depend && $(MAKE) .depend
	$(MAKE) verify

# Roots excluding Double_ratchet (complex; can hang on limited resources)
ROOTS_LITE = $(filter-out Signal_protocol_core.Double_ratchet.fst,$(ROOTS))

# Hax invocation for extraction WITHOUT crypto-backend feature
# This enables the abstract crypto stubs for F* verification
HAX_CLI = cargo-hax -C --no-default-features \; into fstar --z3rlimit 40

# Ensure HACL* is available for crypto primitives
${HACL_HOME}:
	mkdir -p "${HACL_HOME}"
	git clone --depth 1 https://github.com/hacl-star/hacl-star.git "${HACL_HOME}"

# Hand-written F* files (not extracted, should not be deleted)
MANUAL_FST = AbstractCrypto.fst

# Extracted F* files (generated by hax)
EXTRACTED_FST = $(filter-out $(MANUAL_FST),$(wildcard Signal_protocol_core*.fst))

# All F* files to verify (AbstractCrypto first, then extracted modules)
ROOTS = $(MANUAL_FST) $(EXTRACTED_FST)

# Check if extraction is needed
NEEDS_EXTRACTION = $(shell [ -z "$(EXTRACTED_FST)" ] && echo yes)

# Extract F* from Rust if no extracted files exist
ifneq "$(NEEDS_EXTRACTION)" ""
$(info Extracting F* from Rust...)
$(shell $(HAX_CLI))
endif

# Regenerate extracted F* when Rust sources change
$(EXTRACTED_FST): $(shell find ../../../src -type f -name '*.rs')
	@echo "Rust sources changed, re-extracting F*..."
	$(HAX_CLI)

# Discover F* libraries from cargo dependencies
define FINDLIBS
    function print_if_exists() {
        if [ -d "$$1" ]; then echo "$$1"; fi
    }
    function dependencies() {
        cargo metadata --format-version 1 --manifest-path ../../../Cargo.toml 2>/dev/null | \
            jq -r '.packages | .[] | .manifest_path | split("/") | .[:-1] | join("/")' 2>/dev/null || true
    }
    function find_hax_libraries_at_path() {
        path="$$1"
        print_if_exists "$$path/proofs/fstar/extraction"
        MAYBE_PROOF_LIBS=$$(realpath -q "$$path/../proof-libs/fstar" 2>/dev/null || true)
        if [ -d "$$MAYBE_PROOF_LIBS" ]; then
            print_if_exists "$$MAYBE_PROOF_LIBS/core"
            print_if_exists "$$MAYBE_PROOF_LIBS/rust_primitives"
        fi
    }
    { while IFS= read path; do
          find_hax_libraries_at_path "$$path"
      done < <(dependencies)
     } | sort -u
endef
export FINDLIBS

# Hax proof libs from local hax-upstream directory
HAX_PROOF_LIBS = ../../../../hax-upstream/hax-lib/proof-libs/fstar

# Include directories - HACL optional, hax proof libs required.
# ../stubs must come before . so overlays (e.g. Alloc.String with f_to_string) win over
# any extracted copy under this directory or upstream core/.
FSTAR_INCLUDE_DIRS = ../stubs \
  . \
  $(HAX_PROOF_LIBS)/core \
  $(HAX_PROOF_LIBS)/rust_primitives \
  $(HAX_PROOF_LIBS)/hax_lib \
  $(HAX_HOME)/proofs/fstar/extraction \
  $(if $(wildcard $(HACL_HOME)/lib),$(HACL_HOME)/lib)

# --z3refresh: spawn fresh Z3 per query to avoid memory accumulation/hangs
# --z3rlimit: increased for complex modules (Double_ratchet); 40 was too low
FSTAR_FLAGS = --cmi \
  --warn_error -331 \
  --z3version 4.13.3 \
  --z3rlimit 100 \
  --z3refresh \
  --cache_checked_modules --cache_dir $(CACHE_DIR) \
  --already_cached "+Prims+FStar+LowStar+C+Spec.Loops+TestLib" \
  $(addprefix --include ,$(FSTAR_INCLUDE_DIRS))

FSTAR = $(FSTAR_BIN) $(FSTAR_FLAGS)

# Per-F* invocation timeout to avoid unbounded solver/hang. Can be overridden by env.
TIMEOUT ?= 600s

.depend: $(HINT_DIR) $(CACHE_DIR) $(ROOTS)
	$(info ROOTS: $(ROOTS))
	$(FSTAR) --cmi --dep full $(ROOTS) --extract '* -Prims -LowStar -FStar' > $@.tmp
	# Sanitize .depend: remove duplicate/self dependencies that can create circular make rules
	python3 scripts/sanitize_depend.py $@.tmp $@
	$(RM) $@.tmp

include .depend

$(HINT_DIR):
	mkdir -p $@

$(CACHE_DIR):
	mkdir -p $@

# Default verification rule
$(CACHE_DIR)/%.checked: | .depend $(HINT_DIR) $(CACHE_DIR)
	# Run each F* verification with a timeout to prevent unbounded solver/resource usage
	timeout $(TIMEOUT) $(FSTAR) $(OTHERFLAGS) $* $(ENABLE_HINTS) --hint_file $(HINT_DIR)/$(notdir $*).hints

# Double_ratchet: complex protocol - cap memory (512MB) to fail fast instead of hanging;
# use --lax to type-check only (skips SMT) when resources are limited
$(CACHE_DIR)/Signal_protocol_core.Double_ratchet.fst.checked: | .depend $(HINT_DIR) $(CACHE_DIR)
	timeout $(TIMEOUT) $(FSTAR) --z3rlimit 200 --fuel 1 --ifuel 2 \
	  --z3cliopt 'memory_high_watermark_mb=512' \
	  $(OTHERFLAGS) Signal_protocol_core.Double_ratchet.fst $(ENABLE_HINTS) --hint_file $(HINT_DIR)/Signal_protocol_core.Double_ratchet.fst.hints

# Full verification (includes Double_ratchet; may hang on limited resources)
verify: $(addsuffix .checked, $(addprefix $(CACHE_DIR)/,$(ROOTS)))

# Lite verification: Crypto, Keys, Error, Types, X3dh only (skips Double_ratchet)
verify-lite: $(addsuffix .checked, $(addprefix $(CACHE_DIR)/,$(ROOTS_LITE)))

# Extract only (no verification)
extract:
	$(HAX_CLI)

# Interactive mode targets
%.fst-in:
	$(info $(FSTAR_FLAGS) $(ENABLE_HINTS) --hint_file $(HINT_DIR)/$(basename $@).fst.hints)

%.fsti-in:
	$(info $(FSTAR_FLAGS) $(ENABLE_HINTS) --hint_file $(HINT_DIR)/$(basename $@).fsti.hints)

clean:
	rm -rf $(CACHE_DIR) $(HINT_DIR) .depend
	# Remove only extracted files, preserve hand-written AbstractCrypto.fst
	rm -f Signal_protocol_core*.fst Signal_protocol_core*.fsti

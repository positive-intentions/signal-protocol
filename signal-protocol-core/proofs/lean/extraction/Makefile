# Makefile for Lean extraction of signal-protocol-core
#
# Prerequisites:
#  1. elan installed (Lean version manager)
#  2. lean and lake in PATH (via elan)
#  3. cargo, cargo-hax, jq in PATH
#  4. hax-lib as a dependency in Cargo.toml
#  5. eval $(opam env) to have hax-engine in PATH
#
# Usage:
#   make          - Extract Lean from Rust and verify
#   make extract  - Only extract Lean (no verification)
#   make verify   - Verify all Lean files
#   make verify-lite - Verify core modules only (skips Double_ratchet)
#   make clean    - Clean generated files (keeps AbstractCrypto.lean)

HAX_HOME ?= $(abspath ../../../../hax-upstream/hax-lib)

SHELL ?= /usr/bin/env bash

# Check for required executables
EXECUTABLES = cargo cargo-hax jq lake
K := $(foreach bin,$(EXECUTABLES),\
        $(if $(shell command -v $(bin) 2>/dev/null),,$(error "No $(bin) in PATH")))

.PHONY: all verify verify-lite extract clean help

# Hax invocation for extraction WITHOUT crypto-backend feature
# This enables the abstract crypto stubs for Lean verification
HAX_CLI = cargo-hax -C --no-default-features \; into lean

# Hand-written Lean files (not extracted, should not be deleted)
MANUAL_LEAN = AbstractCrypto.lean

# Extracted Lean files (generated by hax)
EXTRACTED_LEAN = $(filter-out $(MANUAL_LEAN),$(wildcard Signal_protocol_core*.lean))

# All Lean files to verify
ROOTS = $(MANUAL_LEAN) $(EXTRACTED_LEAN)

# Check if extraction is needed
NEEDS_EXTRACTION = $(shell [ -z "$(EXTRACTED_LEAN)" ] && echo yes)

# Extract Lean from Rust if no extracted files exist
ifneq "$(NEEDS_EXTRACTION)" ""
$(info Extracting Lean from Rust...)
$(shell cd ../../.. && $(HAX_CLI))
endif

# Default target: extract and verify
all: verify

# Extract only (no verification)
extract:
	$(info Extracting Lean from Rust...)
	cd ../../.. && $(HAX_CLI)

# Patch extracted file for format! compatibility (hax extracts new_v1 with value args)
# new_v1 -> new_v1_fmt, then new_v1_fmt -> new_v1_fmt_str (format strings are Vector String)
patch-extraction: extract
	sed -i 's/core_models\.fmt\.rt\.Impl_1\.new_v1/core_models.fmt.rt.Impl_1.new_v1_fmt/g' signal_protocol_core.lean 2>/dev/null || true
	sed -i 's/core_models\.fmt\.rt\.Impl_1\.new_v1_fmt/core_models.fmt.rt.Impl_1.new_v1_fmt_str/g' signal_protocol_core.lean 2>/dev/null || true
	perl -i -0pe 's/\(alloc\.slice\.Impl\.to_vec\n        \(← \(alloc\.slice\.Impl\.sort alloc\.string\.String/\(alloc.slice.Impl.to_vec alloc.string.String (← (alloc.slice.Impl.sort alloc.string.String/g' signal_protocol_core.lean 2>/dev/null || true
	sed -i 's/(alloc\.vec\.Impl_1\.as_slice keys)/(alloc.vec.Impl_1.as_slice (_Allocator := alloc.alloc.Global) keys)/g' signal_protocol_core.lean 2>/dev/null || true
	perl patch_fold.pl signal_protocol_core.lean > signal_protocol_core.lean.tmp && mv signal_protocol_core.lean.tmp signal_protocol_core.lean

# Verify all Lean files using lake
verify: patch-extraction
	$(info Verifying Lean files...)
	cd .. && lake build

# Verify core modules only (Crypto, Keys, Error, Types, X3dh)
verify-lite: patch-extraction
	$(info Verifying core Lean modules only...)
	cd .. && lake build extraction.AbstractCrypto

# Clean generated files (keeps AbstractCrypto.lean)
clean:
	rm -f Signal_protocol_core*.lean
	cd .. && rm -rf .lake lake-manifest.json

help:
	@echo "Lean Verification for Signal Protocol Core"
	@echo ""
	@echo "Targets:"
	@echo "  all         - Extract and verify all Lean files (default)"
	@echo "  extract     - Only extract Lean from Rust (no verification)"
	@echo "  verify      - Verify all Lean files"
	@echo "  verify-lite - Verify core modules only (Crypto, Keys, Error, Types, X3dh)"
	@echo "  clean       - Clean generated files"
	@echo "  help        - Show this help message"
	@echo ""
	@echo "Environment Variables:"
	@echo "  HAX_HOME    - Path to hax-lib (default: ../../hax-upstream/hax-lib)"
	@echo ""
	@echo "Note: Full verification of hax-extracted files requires the hax Lean library"
	@echo "      to be available at the path specified in lakefile.toml."

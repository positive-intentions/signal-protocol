-- allium: 3
-- signal-protocol-core.allium
--
-- Scope: behavioural contract for signal-protocol-core X3DH + Double Ratchet
--        and the cascade product invariants that bind OTPK / decrypt commit.
-- Includes: handshake entities, session ratchet rules, skipped-key handling,
--           associated-data binding, signed-prekey verification, fail-closed
--           ratchet init (role + SPK + AD), XEdDSA canonicity.
-- Excludes:
--   - WASM/JS storybook and gallery UI
--   - Formal-proof stub builds without crypto-backend
--   - Non-domain infrastructure (logging, webpack, Docker)
--
-- Finding IDs refer to security/SP-2026-library-audit.md.
-- SP-2026-001–017 are mitigated in-tree; regenerate identities after upgrade.
-- No open questions remain for this hardening pass.

entity IdentityKey {
    public: Bytes
    private: Bytes
}

entity SignedPrekey {
    public: Bytes
    private: Bytes
    signature: Bytes
    sign_public: Bytes
}

entity OneTimePrekey {
    id: Integer
    public: Bytes
    private: Bytes
}

entity PrekeyBundle {
    identity: IdentityKey
    signed_prekey: SignedPrekey
    one_time_prekey: OneTimePrekey?
}

entity Session {
    role: initiator | responder
    root_key: Bytes
    sending_chain_key: Bytes?
    receiving_chain_key: Bytes?
    sending_dh_public: Bytes?
    receiving_dh_public: Bytes?
    sending_message_number: Integer
    receiving_message_number: Integer
    previous_chain_length: Integer
    skipped: SkippedMessageKey
    associated_data: Bytes
}

entity SkippedMessageKey {
    session: Session
    ratchet_public: Bytes
    message_number: Integer
    message_key: Bytes
}

entity RatchetHeader {
    dh_public: Bytes
    message_number: Integer
    previous_chain_length: Integer
}

entity CiphertextMessage {
    header: RatchetHeader
    body: Bytes
}

config {
    max_skip_per_chain: Integer = 1000
    max_skipped_total: Integer = 1000
}

-- Mitigated (SP-2026-008): max_skipped_total enforced with FIFO eviction.
-- Forged large PN/N leave skipped set unchanged (tentative discard).
invariant SkippedKeysAreBounded {
    for s in Sessions:
        s.skipped.count <= config.max_skipped_total
}

-- Mitigated (SP-2026-014): cascade wire v4 binds OTPK id; responder removes
-- exactly that pool entry once. Library + product enforce single-use.
invariant OneTimePreKeysBelongToOneSession {
    for a in Handshakes:
        for b in Handshakes:
            a != b and a.one_time_prekey != null
                implies a.one_time_prekey.id != b.one_time_prekey.id
}

-- Desired: responder does not send before establishing a receiving ratchet.
invariant ResponderCannotSendBeforeReceiving {
    for s in Sessions:
        s.role = responder and s.receiving_dh_public = null
            implies s.sending_chain_key = null
}

-- Mitigated (SP-2026-002, SP-2026-003): DR commit-after-AEAD.
invariant DecryptCommitsOnlyAfterTag {
    for d in DecryptAttempts:
        d.state_mutated implies d.tag_ok
}

-- Mitigated (SP-2026-015): product decrypt_from_peer / group path clone then
-- assign only after inner AEAD succeeds.
invariant ProductDecryptCommitsAfterAuth {
    for d in ProductDecryptAttempts:
        d.local_or_session_committed implies d.inner_aead_ok
}

-- Mitigated (SP-2026-003): skipped keys removed only after successful decrypt.
invariant SkippedKeyRemovedOnlyAfterTag {
    for d in DecryptAttempts:
        d.used_skipped_key and d.skipped_key_deleted implies d.tag_ok
}

-- Mitigated (SP-2026-001): on DH ratchet, retain remaining previous-chain keys via PN.
invariant PreviousChainKeysRetainedOnRatchet {
    for d in DecryptAttempts:
        d.triggered_dh_ratchet implies
            d.archived_previous_chain_keys_count = d.header.previous_chain_length - d.receiving_chain_length_before
}

-- Mitigated (SP-2026-004): initiate verifies signed prekey inside the library.
invariant SignedPrekeyVerifiedInInitiate {
    for h in Handshakes:
        h.role = initiator implies h.signed_prekey_verified = true
}

-- Mitigated (SP-2026-005): AD binds both identity public keys and is used in AEAD.
invariant AssociatedDataBindsIdentities {
    for s in Sessions:
        s.associated_data = s.peer_identity_public || s.local_identity_public
            or s.associated_data = s.local_identity_public || s.peer_identity_public
}

-- Mitigated (SP-2026-012): single typed init; empty AD and missing SPK rejected;
-- no Signal_Initial_Chain branch.
invariant InitRequiresSpkAndAd {
    for i in RatchetInits:
        i.accepted implies
            length(i.associated_data) > 0
            and length(i.spk_public) = 32
            and i.first_chain_via_spk_dh = true
}

-- Mitigated (SP-2026-013): XEdDSA matches Signal spec (hash1 nonce domain,
-- sign-bit 0 Edwards encoding, canonical s, single verify candidate).
invariant XEdDSACanonical {
    for s in Signatures:
        s.accepted implies
            s.s_canonical = true
            and s.public_sign_bit = 0
            and s.verify_candidates = 1
}

-- Mitigated (SP-2026-011): message keys stay inside the library (WASM).
invariant MessageKeyNotExported {
    for e in EncryptResults:
        e.exposed_to_host implies e.message_key = null
}

rule X3DHInitiate {
    when: InitiatorReceivesPrekeyBundle(bundle)

    requires: exists bundle.identity
    requires: exists bundle.signed_prekey
    requires: SignedPrekeySignatureValid(bundle)

    ensures:
        let session = Session.created(
            role: initiator,
            associated_data: IdentityAssociatedData(bundle.identity, initiator.identity)
        )
        Handshake.created(
            session: session,
            one_time_prekey: bundle.one_time_prekey,
            one_time_prekey_id: bundle.one_time_prekey.id
        )
}

rule DoubleRatchetInit {
    when: HandshakeComplete(shared_secret, associated_data, role)

    requires: length(associated_data) > 0
    requires: length(shared_secret) = 32
    requires: role has remote_spk_public or local_spk

    ensures:
        Session.created(
            role: role,
            associated_data: associated_data,
            first_chain_via_spk_dh: true
        )
}

rule DoubleRatchetDecrypt {
    when: SessionReceivesCiphertext(session, message)

    requires: exists session

    ensures:
        -- 1) try skipped keys without deleting until tag ok
        -- 2) if new DH: archive previous chain using PN, then ratchet on a tentative copy
        -- 3) derive message key, AEAD open, commit state only if tag ok
        DecryptAttempt.created(
            session: session,
            header: message.header,
            tag_ok: true
        )
}

-- Resolved (SP-2026 hardening): fail-closed init API; XEdDSA-to-spec + interop
-- vectors; product clone-commit; wire v4 OTPK id; ProVerif models updated;
-- cascade 100% line coverage. Hard break: regenerate IKs and re-sign SPK/PQ.
